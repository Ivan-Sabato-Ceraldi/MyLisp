(import ("list.mylisp")
    (let* (
            (check-string (lambda (fName pos s)
                (cond
                    ((not (string? fName)) (error "check-string needs a string as its first arg"))
                    ((not (int? pos)) (error "check-string needs an int as its second arg"))
                    ((not (string? s)) (error (concat fName " requires a string arg at position " (int->string pos))))
                    (else true))))
            (check-natural (lambda (fName pos n)
                (cond
                    ((not (string? fName)) (error "check-natural needs a string as its first arg"))
                    ((not (int? pos)) (error "check-natural needs an int as its second arg"))
                    ((or (not (int? n)) (< n 0)) (error (concat fName " requires a natural number (>= 0) arg at position " (int->string pos))))
                    (else true))))
            (implode (lambda (chars)
                (concat-all chars)))
            (string-length (lambda (s)
                (let* ((_ (check-string "string-length" 1 s)))
                    (length (explode s)))))
            (string-empty? (lambda (s)
                (let* ((_ (check-string "string-empty?" 1 s)))
                    (= s ""))))
            (string-reverse (lambda (s)
                (let* ((_ (check-string "string-reverse" 1 s)))
                    (concat-all (reverse (explode s))))))
            (palindrome? (lambda (s)
                (let* ((_ (check-string "palindrome?" 1 s)))
                    (= s (string-reverse s)))))
        )
        (letrec (
                (list-ref (lambda (lst i)
                    (cond
                        ((null? lst) (error "string-ref: index out of bounds"))
                        ((= i 0) (car lst))
                        (else (list-ref (cdr lst) (- i 1))))))
                (take (lambda (lst n)
                    (cond
                        ((= n 0) '())
                        ((null? lst) (error "substring: end index out of bounds"))
                        (else (cons (car lst) (take (cdr lst) (- n 1)))))))
                (drop (lambda (lst n)
                    (cond
                        ((= n 0) lst)
                        ((null? lst) (error "substring: start index out of bounds"))
                        (else (drop (cdr lst) (- n 1))))))
                (prefix-list? (lambda (pre lst)
                    (cond
                        ((null? pre) true)
                        ((null? lst) false)
                        ((= (car pre) (car lst)) (prefix-list? (cdr pre) (cdr lst)))
                        (else false))))
                (contains-list? (lambda (sub lst)
                    (cond
                        ((prefix-list? sub lst) true)
                        ((null? lst) false)
                        (else (contains-list? sub (cdr lst))))))
                (index-of-list (lambda (sub lst idx)
                    (cond
                        ((prefix-list? sub lst) idx)
                        ((null? lst) -1)
                        (else (index-of-list sub (cdr lst) (+ idx 1))))))
                (replace-list (lambda (old new lst)
                    (cond
                        ((null? lst) '())
                        ((prefix-list? old lst)
                            (append new (replace-list old new (drop lst (length old)))))
                        (else (cons (car lst) (replace-list old new (cdr lst)))))))
                (split-list (lambda (sep lst acc)
                    (cond
                        ((null? lst) (list (concat-all (reverse acc))))
                        ((prefix-list? sep lst)
                            (cons (concat-all (reverse acc))
                                  (split-list sep (drop lst (length sep)) '())))
                        (else (split-list sep (cdr lst) (cons (car lst) acc))))))
                (drop-leading-spaces (lambda (lst)
                    (cond
                        ((null? lst) '())
                        ((or (= (car lst) " ") (= (car lst) "\t") (= (car lst) "\n"))
                            (drop-leading-spaces (cdr lst)))
                        (else lst))))
            )
            (let* (
                    (string-ref (lambda (s i)
                        (let* ((_ (check-string "string-ref" 1 s)) (_ (check-natural "string-ref" 2 i)))
                            (list-ref (explode s) i))))
                    (substring (lambda (s start end)
                        (let* ((_ (check-string "substring" 1 s))
                               (_ (check-natural "substring" 2 start))
                               (_ (check-natural "substring" 3 end)))
                            (if (> start end)
                                (error "substring: start index cannot be greater than end index")
                                (concat-all (take (drop (explode s) start) (- end start)))))))
                    (starts-with? (lambda (s prefix)
                        (let* ((_ (check-string "starts-with?" 1 s)) (_ (check-string "starts-with?" 2 prefix)))
                            (prefix-list? (explode prefix) (explode s)))))
                    (ends-with? (lambda (s suffix)
                        (let* ((_ (check-string "ends-with?" 1 s)) (_ (check-string "ends-with?" 2 suffix)))
                            (prefix-list? (reverse (explode suffix)) (reverse (explode s))))))
                    (contains? (lambda (s sub)
                        (let* ((_ (check-string "contains?" 1 s)) (_ (check-string "contains?" 2 sub)))
                            (contains-list? (explode sub) (explode s)))))
                    (index-of (lambda (s sub)
                        (let* ((_ (check-string "index-of" 1 s)) (_ (check-string "index-of" 2 sub)))
                            (index-of-list (explode sub) (explode s) 0))))
                    (string-repeat (lambda (s n)
                        (let* ((_ (check-string "string-repeat" 1 s)) (_ (check-natural "string-repeat" 2 n)))
                            (letrec (
                                    (rep-iter (lambda (k acc)
                                        (if (= k 0)
                                            acc
                                            (rep-iter (- k 1) (concat s acc)))))
                                )
                                (rep-iter n "")))))
                    (string-join (lambda (sep strs)
                        (let* ((_ (check-string "string-join" 1 sep)))
                            (cond
                                ((not (list? strs)) (error "string-join requires a list arg at position 2"))
                                ((null? strs) "")
                                (else
                                    (let* ((_ (check-string "string-join" 2 (car strs))))
                                        (foldl (lambda (acc item)
                                            (let* ((_ (check-string "string-join" 2 item)))
                                                (concat acc sep item)))
                                            (car strs)
                                            (cdr strs))))))))
                    (string-split (lambda (s sep)
                        (let* ((_ (check-string "string-split" 1 s)) (_ (check-string "string-split" 2 sep)))
                            (if (= sep "")
                                (explode s)
                                (split-list (explode sep) (explode s) '())))))
                    (string-replace (lambda (s old new)
                        (let* ((_ (check-string "string-replace" 1 s))
                               (_ (check-string "string-replace" 2 old))
                               (_ (check-string "string-replace" 3 new)))
                            (if (= old "")
                                s
                                (concat-all (replace-list (explode old) (explode new) (explode s)))))))
                    (string-trim-left (lambda (s)
                        (let* ((_ (check-string "string-trim-left" 1 s)))
                            (concat-all (drop-leading-spaces (explode s))))))
                    (string-trim-right (lambda (s)
                        (let* ((_ (check-string "string-trim-right" 1 s)))
                            (concat-all (reverse (drop-leading-spaces (reverse (explode s))))))))
                    (string-trim (lambda (s)
                        (let* ((_ (check-string "string-trim" 1 s)))
                            (string-trim-left (string-trim-right s)))))
                )
                (export implode string-length string-empty?
                        string-reverse palindrome? string-ref substring
                        starts-with? ends-with? contains? index-of
                        string-repeat string-join string-split string-replace
                        string-trim-left string-trim-right string-trim)))))