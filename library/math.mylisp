(import ("list.mylisp")
    (let* (
            (check-num (lambda (fName pos n)
                (cond
                    ((not (string? fName)) (error "check-num needs a string as its first arg"))
                    ((not (int? pos)) (error "check-num needs an int as its second arg"))
                    ((not (number? n)) (error (concat fName " requires a number arg at position " (int->string pos))))
                    (else true))))
            (check-int (lambda (fName pos n)
                (cond
                    ((not (string? fName)) (error "check-int needs a string as its first arg"))
                    ((not (int? pos)) (error "check-int needs an int as its second arg"))
                    ((not (int? n)) (error (concat fName " requires an integer arg at position " (int->string pos))))
                    (else true))))
            (check-natural (lambda (fName pos n)
                (cond
                    ((not (string? fName)) (error "check-natural needs a string as its first arg"))
                    ((not (int? pos)) (error "check-natural needs an int as its second arg"))
                    ((or (not (int? n)) (< n 0)) (error (concat fName " requires a natural number (>= 0) arg at position " (int->string pos))))
                    (else true))))
            (check-list (lambda (fName pos lst)
                (cond
                    ((not (string? fName)) (error "check-list needs a string as its first arg"))
                    ((not (int? pos)) (error "check-list needs an int as its second arg"))
                    ((not (list? lst)) (error (concat fName " requires a list arg at position " (int->string pos))))
                    (else true))))
            (inc (lambda (x)
                (let* ((_ (check-num "inc" 1 x)))
                    (+ x 1))))
            (dec (lambda (x)
                (let* ((_ (check-num "dec" 1 x)))
                    (- x 1))))
            (zero? (lambda (x)
                (let* ((_ (check-num "zero?" 1 x)))
                    (= x 0))))
            (positive? (lambda (x)
                (let* ((_ (check-num "positive?" 1 x)))
                    (> x 0))))
            (negative? (lambda (x)
                (let* ((_ (check-num "negative?" 1 x)))
                    (< x 0))))
            (abs (lambda (x)
                (let* ((_ (check-num "abs" 1 x)))
                    (if (negative? x)
                        (- 0 x)
                        x))))
            (sign (lambda (x)
                (let* ((_ (check-num "sign" 1 x)))
                    (cond
                        ((positive? x) 1)
                        ((zero? x) 0)
                        (else -1)))))
            (min (lambda (x y)
                (let* ((_ (check-num "min" 1 x)) (_ (check-num "min" 2 y)))
                    (if (<= x y) x y))))
            (max (lambda (x y)
                (let* ((_ (check-num "max" 1 x)) (_ (check-num "max" 2 y)))
                    (if (>= x y) x y))))
            (average (lambda (x y)
                (let* ((_ (check-num "average" 1 x)) (_ (check-num "average" 2 y)))
                    (/ (+ x y) 2))))
            (clamp (lambda (min-val max-val x)
                (let* ((_ (check-num "clamp" 1 min-val)) (_ (check-num "clamp" 2 max-val)) (_ (check-num "clamp" 3 x)))
                    (cond
                        ((> min-val max-val) (error "clamp: min cannot be greater than max"))
                        ((> min-val x) min-val)
                        ((< max-val x) max-val)
                        (else x)))))
            (min-list (lambda (nums)
                (let* ((_ (check-list "min-list" 1 nums)))
                    (reduce min nums))))
            (max-list (lambda (nums)
                (let* ((_ (check-list "max-list" 1 nums)))
                    (reduce max nums))))
            (average-list (lambda (nums)
                (let* ((_ (check-list "average-list" 1 nums)))
                    (if (null? nums)
                        (error "cannot compute average-list of an empty list")
                        (/ (sum-all nums) (length nums))))))
        )
        (letrec (
                (even (lambda (x)
                    (let* ((_ (check-int "even" 1 x)))
                        (if (= x 0)
                            true
                            (odd (- (abs x) 1))))))
                (odd (lambda (x)
                    (let* ((_ (check-int "odd" 1 x)))
                        (if (= x 0)
                            false
                            (even (- (abs x) 1))))))
                (gcd (lambda (n1 n2)
                    (let* ((_ (check-natural "gcd" 1 n1)) (_ (check-natural "gcd" 2 n2)))
                        (if (= n2 0)
                            n1
                            (gcd n2 (mod n1 n2))))))
                (fact (lambda (n)
                    (let* ((_ (check-natural "fact" 1 n)))
                        (if (= n 0)
                            1
                            (* n (fact (- n 1)))))))
                (fib (lambda (n)
                    (let* ((_ (check-natural "fib" 1 n)))
                        (letrec (
                                (fib-iter (lambda (k a b)
                                    (if (= k 0)
                                        a
                                        (fib-iter (- k 1) b (+ a b)))))
                            )
                            (fib-iter n 1 1)))))
            )
            (let* (
                    (lcm (lambda (n1 n2)
                        (let* ((_ (check-natural "lcm" 1 n1)) (_ (check-natural "lcm" 2 n2)))
                            (if (and (= n1 0) (= n2 0))
                                0
                                (/ (* n1 n2) (gcd n1 n2))))))
                    (divides? (lambda (n1 n2)
                        (let* ((_ (check-natural "divides?" 1 n1)) (_ (check-natural "divides?" 2 n2)))
                            (if (= n1 0)
                                (error "divides?: divisor cannot be zero")
                                (= 0 (mod n2 n1))))))
                )
                (export inc dec zero? positive? negative? abs sign
                        min max average clamp min-list max-list average-list
                        even odd gcd lcm divides? fact fib)))))