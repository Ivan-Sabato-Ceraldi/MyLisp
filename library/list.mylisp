(import ("combinators.mylisp")
    (let* (
            (check-list (lambda (fName pos lst)
                (cond
                    ((not (string? fName)) (error "check-list needs a string as its first arg"))
                    ((not (int? pos)) (error "check-list needs an int as its second arg"))
                    ((not (list? lst)) (error (concat fName " requires a list arg at position " (int->string pos))))
                    (else true))))
            (check-natural (lambda (fName pos n)
                (cond
                    ((not (string? fName)) (error "check-natural needs a string as its first arg"))
                    ((not (int? pos)) (error "check-natural needs an int as its second arg"))
                    ((or (not (int? n)) (< n 0)) (error (concat fName " requires a natural number (>= 0) arg at position " (int->string pos))))
                    (else true))))
        )
        (letrec (
                (foldl (lambda (f acc lst)
                    (let* ((_ (check-list "foldl" 3 lst)))
                        (if (null? lst)
                            acc
                            (foldl f (f acc (car lst)) (cdr lst))))))
                (foldr (lambda (f acc lst)
                    (let* ((_ (check-list "foldr" 3 lst)))
                        (if (null? lst)
                            acc
                            (f (car lst) (foldr f acc (cdr lst)))))))
                (reduce-r (lambda (f lst)
                    (let* ((_ (check-list "reduce-r" 2 lst)))
                        (cond
                            ((null? lst) (error "cannot reduce-r an empty list"))
                            ((null? (cdr lst)) (car lst))
                            (else (f (car lst) (reduce-r f (cdr lst))))))))
                (length (lambda (lst)
                    (let* ((_ (check-list "length" 1 lst)))
                        (if (null? lst)
                            0
                            (+ 1 (length (cdr lst)))))))
                (filter (lambda (pred lst)
                    (let* ((_ (check-list "filter" 2 lst)))
                        (cond
                            ((null? lst) lst)
                            ((pred (car lst)) (cons (car lst) (filter pred (cdr lst))))
                            (else (filter pred (cdr lst)))))))
                (get (lambda (lst index)
                    (let* ( (_ (check-list "get" 1 lst)) (_ (check-natural "get" 2 index)))
                        (letrec (
                                (get-iter (lambda (curr i)
                                (cond
                                    ((null? curr) (error "get: index out of bounds"))
                                    ((= i 0) (car curr))
                                    (else (get-iter (cdr curr) (- i 1))))))
                            )
                            (get-iter lst index)))))
            )
            (let* (
                    (reduce (lambda (f lst)
                        (let* ((_ (check-list "reduce" 2 lst)))
                            (if (null? lst)
                                (error "cannot reduce an empty list")
                                (foldl f (car lst) (cdr lst))))))
                    (reject (lambda (pred lst)
                        (let* ((_ (check-list "reject" 2 lst)))
                            (filter (negate pred) lst))))
                    (map (lambda (f lst)
                        (let* ((_ (check-list "map" 2 lst)))
                            (foldr (lambda (x acc) (cons (f x) acc)) '() lst))))
                    (append (lambda (l1 l2)
                        (let* ((_ (check-list "append" 1 l1)) (_ (check-list "append" 2 l2)))
                            (foldr (lambda (x acc) (cons x acc)) l2 l1))))
                    (flat-map (lambda (f lst)
                        (let* ((_ (check-list "flat-map" 2 lst)))
                            (foldr (lambda (x acc) (append (f x) acc)) '() lst))))
                    (reverse (lambda (lst)
                        (let* ((_ (check-list "reverse" 1 lst)))
                            (foldl (lambda (acc x) (cons x acc)) '() lst))))
                    (uncurry (lambda (f args)
                        (let* ((_ (check-list "uncurry" 2 args)))
                            (if (null? args)
                                (error "cannot give an empty list of args to an uncurried function")
                                (foldl (lambda (fn arg) (fn arg)) f args)))))
                    (sum-all (lambda (nums)
                        (let* ((_ (check-list "sum-all" 1 nums)))
                            (foldr + 0 nums))))
                    (prod-all (lambda (nums)
                        (let* ((_ (check-list "prod-all" 1 nums)))
                            (foldr * 1 nums))))
                    (concat-all (lambda (strs)
                        (let* ((_ (check-list "concat-all" 1 strs)))
                            (foldr concat "" strs))))
                    (append-all (lambda (lists)
                        (let* ((_ (check-list "append-all" 1 lists)))
                            (foldr append '() lists))))
                )
                (export foldl foldr reduce reduce-r length filter get reject map
                        append flat-map reverse uncurry sum-all prod-all
                        concat-all append-all)))))